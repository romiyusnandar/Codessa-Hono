# Next.js dev server defaults to :3000, so the backend uses :4000 locally to avoid clashing
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Other frontends allowed to call this API with credentials (comma-separated), e.g. a
# separate PR-testing tool. FRONTEND_URL above is always allowed automatically.
ADDITIONAL_ALLOWED_ORIGINS=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=codessa
GITHUB_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=

# GitHub OAuth App (for "Login with GitHub" identity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
JWT_SECRET=

# GitHub App (for posting reviews as "Codessa[bot]" + receiving PR webhooks)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
